      <bpmndi:BPMNEdge id="C_Flow_0_di" bpmnElement="C_Flow_0">
        <di:waypoint x="960" y="500" />
        <di:waypoint x="1590" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Pool_Service_di" bpmnElement="Pool_Service" isHorizontal="true">
        <dc:Bounds x="160" y="630" width="2040" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_Create_di" bpmnElement="S_Create">
