      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="B_Flow_2_di" bpmnElement="B_Flow_2">
        <di:waypoint x="650" y="310" />
        <di:waypoint x="1740" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="B_Flow_3_di" bpmnElement="B_Flow_3">
        <di:waypoint x="1860" y="310" />
        <di:waypoint x="1932" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Pool_Controller_di" bpmnElement="Pool_Controller" isHorizontal="true">
        <dc:Bounds x="160" y="440" width="2040" height="120" />
