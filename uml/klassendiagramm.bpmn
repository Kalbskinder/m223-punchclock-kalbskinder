        <di:waypoint x="1180" y="940" />
        <di:waypoint x="1090" y="940" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Rel_Controller_Entry_di" bpmnElement="Rel_Controller_Entry">
        <di:waypoint x="540" y="170" />
