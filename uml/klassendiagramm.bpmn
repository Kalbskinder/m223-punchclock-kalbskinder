      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Class_PanacheRepository_di" bpmnElement="Class_PanacheRepository">
        <dc:Bounds x="760" y="610" width="300" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Class_Entry_di" bpmnElement="Class_Entry">
        <dc:Bounds x="730" y="870" width="360" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_C_S_di" bpmnElement="Note_C_S">
        <dc:Bounds x="410" y="270" width="180" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_S_R_di" bpmnElement="Note_S_R">
        <dc:Bounds x="410" y="530" width="180" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_R_P_di" bpmnElement="Note_R_P">
        <dc:Bounds x="565" y="630" width="180" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_P_E_di" bpmnElement="Note_P_E">
        <dc:Bounds x="925" y="795" width="120" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Dep_di" bpmnElement="Note_Dep">
        <dc:Bounds x="1230" y="380" width="120" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Note_Legende_di" bpmnElement="Note_Legende">
        <dc:Bounds x="260" y="880" width="260" height="90" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Rel_Controller_Service_di" bpmnElement="Rel_Controller_Service">
        <di:waypoint x="400" y="250" />
        <di:waypoint x="400" y="350" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Rel_Service_Repository_di" bpmnElement="Rel_Service_Repository">
        <di:waypoint x="400" y="510" />
        <di:waypoint x="400" y="610" />
